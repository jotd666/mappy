.key nope
set gamename mappy
set game ${gamename}_aga
copy $game.RNC mappy:$game
set game ${gamename}_ecs
copy $game.RNC mappy:$game
protect mappy:$game RWED
;set game ${gamename}_ocs
;copy $game.RNC mappy:$game
;protect mappy:$game RWED

; shell
set game $gamename
echo $game
copy $game mappy:$game
protect mappy:$game RWED
copy readme.md mappy:


if exists mappy:$game.high
   delete mappy:$game.high
endif

set game $gamename
set arc ${game}_HD.lha
if exists ${arc}
    echo deleting ${arc}...
    delete ${arc}
endif

; also archive with lha
lha a -r $arc ${game}_HD

