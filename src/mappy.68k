play_sound:
    move.l  d0,-(a7)
    move.l  a0,d0
    sub.l   a6,d0
    sub.w   #0x4040,d0
    jbsr    osd_sound_start
    move.l  (a7)+,d0
    rts


sound_control:
    tst.b   d0
    jeq     0f
    jbra    play_sound
0:
    * we should stop the sound, but it actually isn't
    * needed, and doing so would stop the music
    rts

	.include "include.inc"

* mappy is the exact same hw as dig dug 2!!
*	map(0x0000, 0x0fff).ram().w(FUNC(mappy_state::mappy_videoram_w)).share("videoram")	|
*	map(0x1000, 0x27ff).ram().share("spriteram");   // work RAM with embedded sprite RAM
*   sprites start at stack_top_1780 with 3 buffers of $800 bytes that hold attributes, code and coords
*   64 sprites can be displayed total
*	map(0x3800, 0x3fff).w(FUNC(mappy_state::mappy_scroll_w))	|   // scroll
*	map(0x4000, 0x43ff).rw(m_namco_15xx, FUNC(namco_15xx_device::sharedram_r), FUNC(namco_15xx_device::sharedram_w))	|   // shared RAM with the sound CPU
*	map(0x4800, 0x480f).rw("namcoio_1", FUNC(namcoio_device::read), FUNC(namcoio_device::write))	|   // custom I/O chips interface
*	map(0x4810, 0x481f).rw("namcoio_2", FUNC(namcoio_device::read), FUNC(namcoio_device::write))	|   // custom I/O chips interface
*	map(0x5000, 0x500f).w("mainlatch", FUNC(ls259_device::write_a0))	|   // various control bits
*	map(0x8000, 0x8000).w("watchdog", FUNC(watchdog_timer_device::reset_w))	|
*	map(0x8000, 0xffff).rom();  // only a000-ffff in Mappy


* completely unused second clocks




* global state 1402 seems to have 2 part
* higher nibble: 0,1,2,3 when game doesn't run, 4,5,6,7 when game runs

* set by namco chip when enough credits, 0: none, 1: 1 player, 2: 2 players
* bit 3 bot both

* DP=$2000

game_start_a000:
	move.w	#stack_top_1780,d5              	| [$a000: lds    #stack_top_1780]
	move.b	#0x00,d0                        	| [$a004: ldd    #$0000]
	move.w	#0x0000,d1                      	| [$a004: ldd    #$0000]
	MAKE_D                                 	| [...]
	GET_ADDRESS	0x13e4                     	| [$a007: std    $13e4]
	move.w	d1,(a0) |  [...]
* install jump table in ram
	move.w	#function_and_args_table_d020,d2	| [$a00a: ldx    #function_and_args_table_d020]
	move.w	#0x1400,d4                      	| [$a00d: ldu    #$1400]
l_a010:
	GET_REG_ADDRESS	0,d2                   	| [$a010: ldd    ,x++] ROM entry
	addq.w	#2,d2                           	| [...]
	LOAD_D                                 	| [$a010: ldd    ,x++] ROM entry
	jeq	l_a01a                             	| [$a012: beq    $a01a]
	GET_REG_ADDRESS	0,d2                   	| [$a014: ldu    ,x++] destination address in RAM
	addq.w	#2,d2                           	| [...]
	MOVE_W_TO_REG	a0,d4                         	| [...]
	MAKE_D                                 	| [...]
	GET_REG_ADDRESS	0,d4                   	| [$a016: std    ,u]
	MOVE_W_FROM_REG	d1,a0                         	| [...]
	jra	l_a010                             	| [$a018: bra    $a010]
l_a01a:
	GET_ADDRESS	namco_io_4809              	| [$a01a: clr    namco_io_4809]
	clr.b	(a0)                         	| [...]
	moveq	#0,d0                            	| [$a01d: clra]
	GET_ADDRESS	sync_1382                  	| [$a01e: sta    sync_1382]
	move.b	d0,(a0)                         	| [...]

mainloop_a021:
	GET_ADDRESS	sync_1382                  	| [$a021: lda    sync_1382]
	move.b	(a0),d0                         	| [...]
	jeq	mainloop_a021                      	| [$a024: beq    mainloop_a021]
	GET_ADDRESS	0x137e                     	| [$a026: lda    $137e]
	move.b	(a0),d0                         	| [...]
	BIT	#0x08,d0                           	| [$a029: bita   #$08]
	jne	l_f576                             	| [$a02b: lbne   $f576]
	moveq	#0,d0                            	| [$a02f: clra]
	GET_ADDRESS	sync_1382                  	| [$a030: sta    sync_1382]
	move.b	d0,(a0)                         	| [...]
* cheat DSW / freeze?
	GET_ADDRESS	namco_io_4814              	| [$a033: lda    namco_io_4814]
	move.b	(a0),d0                         	| [...]
	BIT	#0x04,d0                           	| [$a036: bita   #$04]
	jeq	l_a03c                             	| [$a038: beq    $a03c]
	OP_W_ON_DP_ADDRESS	addq,level_complete_32,#1| [$a03a: inc    <level_complete_32]
l_a03c:
	GET_ADDRESS	0x1360                     	| [$a03c: lda    $1360]
	move.b	(a0),d0                         	| [...]
	GET_ADDRESS	0x1381                     	| [$a03f: anda   $1381]
	and.b	(a0),d0                          	| [...]
	GET_ADDRESS	0x1393                     	| [$a042: sta    $1393]
	move.b	d0,(a0)                         	| [...]
	GET_ADDRESS	start_number_of_players_1371	| [$a045: lda    start_number_of_players_1371]
	move.b	(a0),d0                         	| [...]
	jeq	l_a056                             	| [$a048: beq    $a056]
* start 1P/2P detected
	move.l	#l_aa7e,d2
	ENCODE_ADDRESS	d2,d2  | encode the address else it's wrongly decoded!
	GET_ADDRESS	0x1400                     	| [$a04d: stx    $1400]
	move.w	d2,(a0) |  [...]
	GET_ADDRESS	sound_highscore_404d       	| [$a050: clr    sound_highscore_404d]
	clr.b	(a0)                         	| [...]
	jbsr	osd_music_stop
	GET_ADDRESS	sound_hiscore_entered_404e 	| [$a053: clr    sound_hiscore_entered_404e]
	clr.b	(a0)                         	| [...]
	jbsr	osd_music_stop
l_a056:
	move.w	#function_and_args_table_d020,d2	| [$a056: ldx    #function_and_args_table_d020]
* call function chain in a loop
l_a059:
	GET_REG_ADDRESS	0,d2                   	| [$a059: ldd    ,x++]
	addq.w	#2,d2                           	| [...]
	LOAD_D                                 	| [$a059: ldd    ,x++]
	jeq	l_a067                             	| [$a05b: beq    $a067] zero: stop calling functions, increment clocks
	GET_REG_ADDRESS	0,d2                   	| [$a05d: ldu    ,x++]
	addq.w	#2,d2                           	| [...]
	MOVE_W_TO_REG	a0,d4                         	| [...]
	GET_REG_ADDRESS	0,d5 |  [$a05f: pshs   x]
	move.w	d2,-(a0)  | pushing on target stack
* indirect_jump to the value contained in argument (14xx)
* which is equal to value of X, but maybe not all the time
	JSR_INDIRECT	0x0,d4 |  [$a061: jsr    [,u]]
	GET_REG_ADDRESS	0,d5 |  [$a063: puls   x]
	move.w	(-2,a0),d2  | pulling from target stack
	jra	l_a059                             	| [$a065: bra    $a059]
